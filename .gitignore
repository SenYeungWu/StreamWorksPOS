# ==============================================================================
# Stream Works (POS) - .gitignore
# Covers Flutter, Dart, Node.js, Fastlane, IDEs, and OS artifacts
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Flutter & Dart Artifacts
# ------------------------------------------------------------------------------
.dart_tool/
.packages
.pub/
.pub-cache/
build/
coverage/

# Flutter generated files
.flutter-plugins
.flutter-plugins-dependencies
.metadata

# Symbol files
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# 2. Node.js & Backend Services (backend/server/)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development
.env.test
.env.production
!.env.example

# Signing Keys, Keystores & Credentials
*.keystore
*.jks
*.p12
*.cer
*.crt
*.key
*.pem
*.mobileprovision
key.properties
google-services.json
GoogleService-Info.plist

# Fastlane Credentials & Outputs
fastlane/google-play-service-account.json
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# ------------------------------------------------------------------------------
# 4. IDEs, Editors & Tooling
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ / Android Studio
.idea/
*.iml
*.iws
*.ipr
out/
cmake-build-*/

# Miscellaneous Editors
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 5. Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~

# ------------------------------------------------------------------------------
# 6. Local Scripts & Archive Outputs
# ------------------------------------------------------------------------------
*.log
*.zip
*.tar.gz
StreamWorks_clean_*.zip
StreamWorks_release.zip
